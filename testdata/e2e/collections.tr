// Arrays and maps (ADR-0013): literals, indexing, methods, value
// semantics, iteration.
fn total(xs: Array<Int>) -> Int {
    let mut sum = 0
    for x in xs {
        sum = sum + x
    }
    return sum
}

fn main() -> Unit {
    let mut scores = [72, 95, 64]
    scores.push(88)
    scores[0] = 75
    print(scores)
    print("count ${scores.len()}, total ${total(scores)}")

    let snapshot = scores
    scores[1] = 0
    print("snapshot ${snapshot}, scores ${scores}")

    let mut grid = [[1, 2], [3, 4]]
    grid[1][0] = 30
    grid[0].push(5)
    print(grid)

    let mut ages = ["sam": 31, "ana": 28]
    ages["bob"] = 40
    ages["sam"] = 32
    for name in ages {
        print("${name} is ${ages[name]}")
    }
    print(ages.get("ana"))
    print(ages.get("zed"))
    print(ages.remove("bob"))
    print(ages)
    print(ages.contains("bob"))

    let mut stack: Array<String> = []
    stack.push("a")
    stack.push("b")
    print(stack.pop())
    print(stack)
}
