{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tread",
  "scopeName": "source.tread",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.tread", "match": "//.*$" },
        { "name": "comment.block.tread", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.tread",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.tread", "match": "\\\\[\\\\\"nrt$]" },
        {
          "name": "meta.interpolation.tread",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.tread" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.tread" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.function.tread" }, "2": { "name": "entity.name.function.tread" } }
        },
        {
          "match": "\\b(struct|enum|impl)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.tread" }, "2": { "name": "entity.name.type.tread" } }
        },
        {
          "match": "\\b(test)\\s+(?=\")",
          "captures": { "1": { "name": "keyword.other.test.tread" } }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.tread", "match": "\\b(if|else|while|for|in|break|continue|return|match)\\b" },
        { "name": "keyword.other.tread", "match": "\\b(let|mut|module|import|pub|fn|struct|enum|impl|test)\\b" },
        { "name": "constant.language.boolean.tread", "match": "\\b(true|false)\\b" },
        { "name": "variable.language.self.tread", "match": "\\bself\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.tread", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.tread", "match": "\\b[0-9]+\\b" }
      ]
    },
    "types": {
      "name": "entity.name.type.tread",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.tread" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.tread", "match": "->|=>" },
        { "name": "keyword.operator.range.tread", "match": "\\.\\." },
        { "name": "keyword.operator.tread", "match": "==|!=|<=|>=|&&|\\|\\||[-+*/%<>=!]" }
      ]
    }
  }
}
